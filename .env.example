# Copy to .env and fill in. NEVER commit .env.

# --- Telegram (see README: "Create a Telegram bot") ---
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_TOKEN_FROM_BOTFATHER
# Personal chats are positive numbers, groups/supergroups are negative (e.g. -1001234567890)
TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
# Public URL used in links (set to your domain if you have one)
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_PORT=3000
# 0.0.0.0 = reachable from the internet. Use 127.0.0.1 when behind a reverse proxy.
GRAFANA_BIND=0.0.0.0
